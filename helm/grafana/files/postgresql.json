{
  "uid": "postgres-overview",
  "title": "PostgreSQL - Overview",
  "tags": ["postgres", "database", "customer-msa"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Exporter UP (per store)",
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [
        {"refId": "A", "expr": "pg_up", "legendFormat": "{{db_instance}} {{job}}", "datasource": {"type": "prometheus", "uid": "mimir"}}
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total connections",
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [
        {"refId": "A", "expr": "sum(pg_stat_database_numbackends)", "legendFormat": "backends", "datasource": {"type": "prometheus", "uid": "mimir"}}
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cache hit ratio (5m)",
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "sum(rate(pg_stat_database_blks_hit[5m])) / (sum(rate(pg_stat_database_blks_hit[5m])) + sum(rate(pg_stat_database_blks_read[5m])))", "legendFormat": "hit ratio", "datasource": {"type": "prometheus", "uid": "mimir"}}
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Rollback ratio (5m)",
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "sum(rate(pg_stat_database_xact_rollback[5m])) / (sum(rate(pg_stat_database_xact_commit[5m])) + sum(rate(pg_stat_database_xact_rollback[5m])))", "legendFormat": "rollback ratio", "datasource": {"type": "prometheus", "uid": "mimir"}}
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Connections by database",
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "sum by (datname, db_instance) (pg_stat_database_numbackends)", "legendFormat": "{{db_instance}} {{datname}}", "datasource": {"type": "prometheus", "uid": "mimir"}}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Transactions: commits / rollbacks per second",
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "sum by (datname) (rate(pg_stat_database_xact_commit[5m]))", "legendFormat": "commit {{datname}}", "datasource": {"type": "prometheus", "uid": "mimir"}},
        {"refId": "B", "expr": "sum by (datname) (rate(pg_stat_database_xact_rollback[5m]))", "legendFormat": "rollback {{datname}}", "datasource": {"type": "prometheus", "uid": "mimir"}}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Buffer cache: hits / reads per second",
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "sum by (datname) (rate(pg_stat_database_blks_hit[5m]))", "legendFormat": "hit {{datname}}", "datasource": {"type": "prometheus", "uid": "mimir"}},
        {"refId": "B", "expr": "sum by (datname) (rate(pg_stat_database_blks_read[5m]))", "legendFormat": "read {{datname}}", "datasource": {"type": "prometheus", "uid": "mimir"}}
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Row operations per second",
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "sum by (datname) (rate(pg_stat_database_tup_fetched[5m]))", "legendFormat": "fetched {{datname}}", "datasource": {"type": "prometheus", "uid": "mimir"}},
        {"refId": "B", "expr": "sum by (datname) (rate(pg_stat_database_tup_returned[5m]))", "legendFormat": "returned {{datname}}", "datasource": {"type": "prometheus", "uid": "mimir"}},
        {"refId": "C", "expr": "sum by (datname) (rate(pg_stat_database_tup_inserted[5m]))", "legendFormat": "inserted {{datname}}", "datasource": {"type": "prometheus", "uid": "mimir"}},
        {"refId": "D", "expr": "sum by (datname) (rate(pg_stat_database_tup_updated[5m]))", "legendFormat": "updated {{datname}}", "datasource": {"type": "prometheus", "uid": "mimir"}},
        {"refId": "E", "expr": "sum by (datname) (rate(pg_stat_database_tup_deleted[5m]))", "legendFormat": "deleted {{datname}}", "datasource": {"type": "prometheus", "uid": "mimir"}}
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Database size",
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "pg_database_size_bytes", "legendFormat": "{{datname}} ({{db_instance}})", "datasource": {"type": "prometheus", "uid": "mimir"}}
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Locks and activity",
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "sum by (datname, state) (pg_stat_activity_count)", "legendFormat": "activity {{datname}} {{state}}", "datasource": {"type": "prometheus", "uid": "mimir"}},
        {"refId": "B", "expr": "sum by (datname, mode) (pg_locks_count)", "legendFormat": "locks {{datname}} {{mode}}", "datasource": {"type": "prometheus", "uid": "mimir"}}
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Conflicts / deadlocks / temp files",
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "sum by (datname) (rate(pg_stat_database_conflicts[5m]))", "legendFormat": "conflicts {{datname}}", "datasource": {"type": "prometheus", "uid": "mimir"}},
        {"refId": "B", "expr": "sum by (datname) (rate(pg_stat_database_deadlocks[5m]))", "legendFormat": "deadlocks {{datname}}", "datasource": {"type": "prometheus", "uid": "mimir"}},
        {"refId": "C", "expr": "sum by (datname) (rate(pg_stat_database_temp_files[5m]))", "legendFormat": "temp files {{datname}}", "datasource": {"type": "prometheus", "uid": "mimir"}}
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Checkpointer: buffers written",
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "rate(pg_stat_bgwriter_buffers_checkpoint[5m])", "legendFormat": "checkpoint {{db_instance}}", "datasource": {"type": "prometheus", "uid": "mimir"}},
        {"refId": "B", "expr": "rate(pg_stat_bgwriter_buffers_clean[5m])", "legendFormat": "bgwriter clean {{db_instance}}", "datasource": {"type": "prometheus", "uid": "mimir"}},
        {"refId": "C", "expr": "rate(pg_stat_bgwriter_buffers_alloc[5m])", "legendFormat": "buffers alloc {{db_instance}}", "datasource": {"type": "prometheus", "uid": "mimir"}}
      ]
    }
  ]
}
